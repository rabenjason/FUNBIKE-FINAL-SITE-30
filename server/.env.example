# Serveur
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=funbike
DB_PASSWORD=mot_de_passe_a_changer
DB_NAME=funbike
DB_CONNECTION_LIMIT=10

# Origines autorisees a appeler l'API, separees par des virgules.
# Exemple production : https://funbike.mg,https://www.funbike.mg
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentification des utilisateurs (futur dashboard)
# Generez une valeur longue et aleatoire, propre a votre serveur.
# Exemple : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_REFRESH_COOKIE_NAME=funbike_refresh_token
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=auto
AUTH_BCRYPT_COST=12

# Protection contre les connexions repetees
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCK_MINUTES=15

# Ancienne protection machine, conservee uniquement comme secours optionnel
# pour des appels serveur a serveur sur les produits. Desactivee par defaut :
# l'authentification utilisateur reste la regle pour les modifications.
ADMIN_API_KEY=
ALLOW_API_KEY_WRITES=false
