# Serveur
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=funbike
DB_PASSWORD=mot_de_passe_a_changer
DB_NAME=funbike
DB_CONNECTION_LIMIT=10

# Origines autorisees a appeler l'API, separees par des virgules.
# Exemple production : https://funbike.mg,https://www.funbike.mg
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cle optionnelle mais recommandee pour proteger les ecritures (POST, PUT, PATCH, DELETE).
# Si elle est renseignee, le client doit envoyer l'en-tete : x-api-key: votre_cle
ADMIN_API_KEY=
